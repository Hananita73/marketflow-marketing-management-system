PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.co:5432/postgres
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
CORS_ORIGIN=*
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=MarkFlow <onboarding@resend.dev>

# ── Admin notification emails ─────────────────────────────────────────────────
# Every alert (server errors, failed DB operations, app events) is sent here.
# Leave empty to disable email alerting entirely.
ADMIN_EMAIL=

# Protects POST /api/admin/email (raw email sending). Keep it secret — it must
# never ship inside the Flutter app. Generate with: openssl rand -hex 24
ADMIN_API_TOKEN=

# Scoped token for POST /api/alerts, which the Flutter app calls to report
# events. Safe-ish to embed in the client: it can only trigger pre-templated
# alerts to ADMIN_EMAIL, rate limited. Must match the MARKFLOW_ALERT_TOKEN
# dart-define used at build time (defaults to the same dev value).
ALERTS_API_TOKEN=markflow-dev-alerts-token
